{
  "name": "benchmark-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "generate:scenarios": "tsx src/scenarios/generator.ts",
    "seed:db": "tsx src/data/seed.ts",
    "dev:modern": "cross-env RENDER_CONFIG=modern next dev -p 3001",
    "dev:classic": "cross-env RENDER_CONFIG=classic next dev -p 3002",
    "build:modern": "cross-env RENDER_CONFIG=modern next build",
    "build:classic": "cross-env RENDER_CONFIG=classic next build",
    "start:modern": "cross-env RENDER_CONFIG=modern next start -p 3001",
    "start:classic": "cross-env RENDER_CONFIG=classic next start -p 3002"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "next": "^16.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cross-env": "^10.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
